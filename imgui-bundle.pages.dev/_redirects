/addons.* /doc/addons.:splat 301
/python/* /doc/python/:splat 301
/python.* /doc/python.:splat 301
/core-libs/* /doc/core-libs/:splat 301
/core-libs.* /doc/core-libs.:splat 301
/cpp/* /doc/cpp/:splat 301
